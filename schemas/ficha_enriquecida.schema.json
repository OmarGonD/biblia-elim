{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ficha_enriquecida.schema.json",
  "title": "Respuesta del generador para un versículo",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["pos_tisch", "strong", "glosa_interlineal", "rango_semantico", "construccion",
                 "sentido_en_contexto", "matiz", "variantes_textuales", "notas_traduccion",
                 "otros_usos", "nivel_certeza"],
    "properties": {
      "pos_tisch": {"type": "integer", "minimum": 1},
      "strong": {"type": "string", "pattern": "^G[0-9]+$"},
      "glosa_interlineal": {"type": "string", "minLength": 1, "maxLength": 60},
      "rango_semantico": {"type": ["array", "null"], "items": {"type": "string", "minLength": 1, "maxLength": 120}, "minItems": 1, "maxItems": 5},
      "construccion": {"type": ["string", "null"], "minLength": 1, "maxLength": 700},
      "sentido_en_contexto": {"type": ["string", "null"], "minLength": 1, "maxLength": 900},
      "matiz": {"type": ["string", "null"], "minLength": 1, "maxLength": 600},
      "variantes_textuales": {"type": ["string", "null"], "minLength": 1, "maxLength": 600},
      "notas_traduccion": {"type": ["string", "null"], "minLength": 1, "maxLength": 600},
      "otros_usos": {"type": ["array", "null"], "items": {"type": "string", "minLength": 1, "maxLength": 240}, "minItems": 1, "maxItems": 3},
      "nivel_certeza": {"enum": ["alto", "medio", "bajo"]}
    }
  }
}
