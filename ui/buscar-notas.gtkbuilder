<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.0"/>
  <object class="GtkDialog" id="dialog_buscar_notas">
    <property name="can_focus">False</property>
    <property name="title" translatable="yes">Buscar en mis notas</property>
    <property name="default_width">860</property>
    <property name="default_height">600</property>
    <child>
      <object class="GtkBox" id="dialog-vbox">
        <property name="visible">True</property>
        <property name="orientation">vertical</property>
        <property name="spacing">8</property>
        <child>
          <object class="GtkBox" id="box_contenido">
            <property name="visible">True</property>
            <property name="orientation">vertical</property>
            <property name="spacing">6</property>
            <property name="margin_start">12</property>
            <property name="margin_end">12</property>
            <property name="margin_top">8</property>
            <child>
              <object class="GtkBox" id="box_buscar">
                <property name="visible">True</property>
                <property name="spacing">8</property>
                <child>
                  <object class="GtkSearchEntry" id="entry_consulta">
                    <property name="visible">True</property>
                    <property name="can_focus">True</property>
                    <property name="hexpand">True</property>
                    <property name="placeholder_text" translatable="yes">Escribe y busca en todo lo que has escrito</property>
                  <property name="hexpand">True</property>
                  </object>
                </child>
                <child>
                  <object class="GtkCheckButton" id="chk_regex">
                    <property name="label" translatable="yes">E_xpresión regular</property>
                    <property name="visible">True</property>
                    <property name="can_focus">True</property>
                    <property name="use_underline">True</property>
                    <property name="tooltip_text" translatable="yes">Expresión regular de Perl: ^Apóstol, gracia|misericordia, \bfe\b</property>
                  </object>
                </child>
                <child>
                  <object class="GtkCheckButton" id="chk_mayusculas">
                    <property name="label" translatable="yes">_Mayúsculas</property>
                    <property name="visible">True</property>
                    <property name="can_focus">True</property>
                    <property name="use_underline">True</property>
                    <property name="tooltip_text" translatable="yes">Distinguir mayúsculas de minúsculas. Sin marcar, tampoco distingue las tildes.</property>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <object class="GtkBox" id="box_filtros">
                <property name="visible">True</property>
                <property name="spacing">6</property>
                <child>
                  <object class="GtkLabel" id="lbl_etiqueta">
                    <property name="visible">True</property>
                    <property name="label" translatable="yes">_Etiqueta:</property>
                    <property name="use_underline">True</property>
                    <property name="mnemonic_widget">cmb_etiqueta</property>
                  </object>
                </child>
                <child>
                  <object class="GtkDropDown" id="cmb_etiqueta">
                    <property name="visible">True</property>
                    <property name="can_focus">True</property>
                    <property name="tooltip_text" translatable="yes">Las etiquetas se escriben dentro de la nota: #oración, #profecía</property>
                  </object>
                </child>
                <child>
                  <object class="GtkLabel" id="lbl_libro">
                    <property name="visible">True</property>
                    <property name="margin_start">8</property>
                    <property name="label" translatable="yes">_Libro:</property>
                    <property name="use_underline">True</property>
                    <property name="mnemonic_widget">cmb_libro</property>
                  </object>
                </child>
                <child>
                  <object class="GtkDropDown" id="cmb_libro">
                    <property name="visible">True</property>
                    <property name="can_focus">True</property>
                  </object>
                </child>
                <child>
                  <object class="GtkLabel" id="lbl_version">
                    <property name="visible">True</property>
                    <property name="margin_start">8</property>
                    <property name="label" translatable="yes">_Versión:</property>
                    <property name="use_underline">True</property>
                    <property name="mnemonic_widget">cmb_version</property>
                  </object>
                </child>
                <child>
                  <object class="GtkDropDown" id="cmb_version">
                    <property name="visible">True</property>
                    <property name="can_focus">True</property>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <object class="GtkLabel" id="lbl_estado">
                <property name="visible">True</property>
                <property name="xalign">0</property>
                <property name="wrap">True</property>
                <property name="label"></property>
              </object>
            </child>
            <child>
              <object class="GtkScrolledWindow" id="scroll_resultados">
                <property name="visible">True</property>
                <property name="hscrollbar_policy">automatic</property>
                <child>
                  <object class="GtkColumnView" id="tree_resultados">
                    <property name="visible">True</property>
                    <property name="can_focus">True</property>
                  </object>
                </child>
              <property name="vexpand">True</property>
              </object>
            </child>
          <property name="vexpand">True</property>
          </object>
        </child>
        <child>
          <object class="GtkBox" id="action_area">
            <property name="halign">end</property>
            <property name="margin_start">12</property>
            <property name="margin_end">12</property>
            <property name="margin_top">4</property>
            <property name="margin_bottom">12</property>
            <property name="visible">True</property>
            <child>
              <object class="GtkMenuButton" id="btn_exportar">
                <property name="label" translatable="yes">E_xportar…</property>
                <property name="visible">True</property>
                <property name="can_focus">True</property>
                <property name="use_underline">True</property>
                <property name="tooltip_text" translatable="yes">Las notas mostradas en Markdown, para leer o imprimir; o una copia completa de todas en JSON</property>
              </object>
            </child>
            <child>
              <object class="GtkButton" id="btn_importar">
                <property name="label" translatable="yes">_Importar copia…</property>
                <property name="visible">True</property>
                <property name="can_focus">True</property>
                <property name="use_underline">True</property>
                <property name="tooltip_text" translatable="yes">Añade las notas de una copia JSON. No sustituye ni borra ninguna de las tuyas.</property>
              </object>
            </child>
            <child>
              <object class="GtkButton" id="btn_ir">
                <property name="label" translatable="yes">Ir al versículo</property>
                <property name="visible">True</property>
                <property name="can_focus">True</property>
                <property name="sensitive">False</property>
              </object>
            </child>
            <child>
              <object class="GtkButton" id="btn_cerrar">
                <property name="label" translatable="yes">Cerrar</property>
                <property name="visible">True</property>
                <property name="can_focus">True</property>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
  </object>
</interface>
