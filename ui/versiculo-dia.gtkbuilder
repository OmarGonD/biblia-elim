<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.0"/>
  <object class="GtkDialog" id="dialog_versiculo">
    <property name="can_focus">False</property>
    <property name="title" translatable="yes">Versículo del día</property>
    <property name="default_width">560</property>
    <property name="default_height">480</property>
    <child>
      <object class="GtkBox" id="dialog-vbox">
        <property name="visible">True</property>
        <property name="orientation">vertical</property>
        <property name="spacing">8</property>
        <child>
          <object class="GtkBox" id="box_todo">
            <property name="visible">True</property>
            <property name="orientation">vertical</property>
            <property name="spacing">6</property>
            <property name="margin_start">14</property>
            <property name="margin_end">14</property>
            <property name="margin_top">8</property>

            <!-- La fecha, con las flechas para mirar atrás -->
            <child>
              <object class="GtkBox" id="box_fecha">
                <property name="visible">True</property>
                <property name="orientation">horizontal</property>
                <property name="spacing">4</property>
                <child>
                  <object class="GtkButton" id="btn_antes">
                    <property name="visible">True</property>
                    <property name="can_focus">True</property>
                    <property name="tooltip_text" translatable="yes">El día anterior</property>
                    <child>
                      <object class="GtkImage" id="img_antes">
                        <property name="visible">True</property>
                        <property name="icon_name">go-previous-symbolic</property>
                      </object>
                    </child>
                  </object>
                </child>
                <child>
                  <object class="GtkLabel" id="lbl_fecha">
                    <property name="visible">True</property>
                    <property name="xalign">0</property>
                    <property name="label"></property>
                  <property name="hexpand">True</property>
                  <property name="halign">center</property>
                  </object>
                </child>
                <child>
                  <object class="GtkButton" id="btn_despues">
                    <property name="visible">True</property>
                    <property name="can_focus">True</property>
                    <property name="tooltip_text" translatable="yes">El día siguiente</property>
                    <child>
                      <object class="GtkImage" id="img_despues">
                        <property name="visible">True</property>
                        <property name="icon_name">go-next-symbolic</property>
                      </object>
                    </child>
                  </object>
                </child>
                <child>
                  <object class="GtkButton" id="btn_hoy">
                    <property name="label" translatable="yes">Hoy</property>
                    <property name="visible">True</property>
                    <property name="can_focus">True</property>
                    <property name="tooltip_text" translatable="yes">Volver al día de hoy</property>
                  </object>
                </child>
              </object>
            </child>

            <!-- La cita y el texto -->
            <child>
              <object class="GtkLabel" id="lbl_cita">
                <property name="visible">True</property>
                <property name="xalign">0</property>
                <property name="label"></property>
              </object>
            </child>
            <child>
              <object class="GtkScrolledWindow" id="scroll_texto">
                <property name="visible">True</property>
                <property name="can_focus">True</property>
                <property name="hscrollbar_policy">never</property>
                <property name="min_content_height">96</property>
                <child>
                  <object class="GtkViewport" id="viewport_texto">
                    <property name="visible">True</property>
                    <child>
                      <object class="GtkLabel" id="lbl_texto">
                        <property name="visible">True</property>
                        <property name="xalign">0</property>
                        <property name="yalign">0</property>
                        <property name="wrap">True</property>
                        <property name="selectable">True</property>
                        <property name="label"></property>
                      </object>
                    </child>
                  </object>
                </child>
              <property name="vexpand">True</property>
              <property name="valign">center</property>
              </object>
            </child>
            <child>
              <object class="GtkLabel" id="lbl_version">
                <property name="visible">True</property>
                <property name="xalign">0</property>
                <property name="margin_bottom">4</property>
                <property name="label"></property>
              </object>
            </child>

            <!-- La reflexión: corta a posta -->
            <child>
              <object class="GtkLabel" id="lbl_reflexion">
                <property name="visible">True</property>
                <property name="xalign">0</property>
                <property name="label"></property>
              </object>
            </child>
            <child>
              <object class="GtkScrolledWindow" id="scroll_reflexion">
                <property name="visible">True</property>
                <property name="can_focus">True</property>
                <property name="hscrollbar_policy">never</property>
                <property name="min_content_height">92</property>
                <child>
                  <object class="GtkTextView" id="vista_reflexion">
                    <property name="visible">True</property>
                    <property name="can_focus">True</property>
                    <property name="wrap_mode">word-char</property>
                    <property name="accepts_tab">False</property>
                    <property name="left_margin">6</property>
                    <property name="right_margin">6</property>
                    <property name="top_margin">4</property>
                    <property name="bottom_margin">4</property>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <object class="GtkLabel" id="lbl_estado">
                <property name="visible">True</property>
                <property name="xalign">0</property>
                <property name="margin_bottom">4</property>
                <property name="label"></property>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="GtkBox" id="action_area">
            <property name="halign">end</property>
            <property name="margin_start">12</property>
            <property name="margin_end">12</property>
            <property name="margin_top">4</property>
            <property name="margin_bottom">12</property>
            <property name="visible">True</property>
            <child>
              <object class="GtkButton" id="btn_memorizar">
                <property name="label" translatable="yes">Memorizar este</property>
                <property name="visible">True</property>
                <property name="can_focus">True</property>
                <property name="tooltip_text" translatable="yes">Añadirlo a tus versículos para memorizar</property>
              </object>
            </child>
            <child>
              <object class="GtkButton" id="btn_abrir">
                <property name="label" translatable="yes">Abrir en la ventana</property>
                <property name="visible">True</property>
                <property name="can_focus">True</property>
                <property name="tooltip_text" translatable="yes">Ir a este pasaje en el lector</property>
              </object>
            </child>
            <child>
              <object class="GtkButton" id="btn_cerrar">
                <property name="label" translatable="yes">Cerrar</property>
                <property name="visible">True</property>
                <property name="can_focus">True</property>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
  </object>
</interface>
