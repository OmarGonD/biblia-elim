<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk+" version="3.14"/>
  <object class="GtkAdjustment" id="adj_hora">
    <property name="lower">0</property>
    <property name="upper">23</property>
    <property name="value">7</property>
    <property name="step_increment">1</property>
  </object>
  <object class="GtkAdjustment" id="adj_minuto">
    <property name="lower">0</property>
    <property name="upper">59</property>
    <property name="value">0</property>
    <property name="step_increment">5</property>
  </object>
  <object class="GtkDialog" id="dialog_planes">
    <property name="can_focus">False</property>
    <property name="title" translatable="yes">Planes de lectura</property>
    <property name="icon">xiphos-x-16.png</property>
    <property name="default_width">1020</property>
    <property name="default_height">660</property>
    <property name="type_hint">dialog</property>
    <child internal-child="vbox">
      <object class="GtkBox" id="dialog-vbox">
        <property name="visible">True</property>
        <property name="orientation">vertical</property>
        <property name="spacing">8</property>
        <child internal-child="action_area">
          <object class="GtkButtonBox" id="action_area">
            <property name="visible">True</property>
            <property name="layout_style">end</property>
            <child>
              <object class="GtkButton" id="btn_cerrar">
                <property name="label" translatable="yes">Cerrar</property>
                <property name="visible">True</property>
                <property name="can_focus">True</property>
              </object>
            </child>
          </object>
          <packing>
            <property name="expand">False</property>
            <property name="pack_type">end</property>
            <property name="position">2</property>
          </packing>
        </child>
        <child>
          <object class="GtkPaned" id="paned">
            <property name="visible">True</property>
            <property name="can_focus">True</property>
            <property name="position">260</property>
            <property name="margin_start">12</property>
            <property name="margin_end">12</property>
            <property name="margin_top">8</property>
            <child>
              <object class="GtkBox" id="box_izq">
                <property name="visible">True</property>
                <property name="orientation">vertical</property>
                <property name="spacing">6</property>
                <child>
                  <object class="GtkLabel" id="lbl_elige">
                    <property name="visible">True</property>
                    <property name="xalign">0</property>
                    <property name="label" translatable="yes">Elige un plan</property>
                  </object>
                  <packing>
                    <property name="expand">False</property>
                  </packing>
                </child>
                <child>
                  <object class="GtkScrolledWindow" id="scroll_planes">
                    <property name="visible">True</property>
                    <property name="can_focus">True</property>
                    <property name="shadow_type">in</property>
                    <property name="hscrollbar_policy">never</property>
                    <child>
                      <object class="GtkTreeView" id="tree_planes">
                        <property name="visible">True</property>
                        <property name="can_focus">True</property>
                        <property name="headers_visible">False</property>
                        <property name="enable_search">False</property>
                      </object>
                    </child>
                  </object>
                  <packing>
                    <property name="expand">True</property>
                    <property name="fill">True</property>
                  </packing>
                </child>
                <child>
                  <object class="GtkBox" id="box_personal">
                    <property name="visible">True</property>
                    <property name="spacing">4</property>
                    <property name="homogeneous">True</property>
                    <child>
                      <object class="GtkButton" id="btn_nuevo">
                        <property name="label" translatable="yes">Nuevo plan…</property>
                        <property name="visible">True</property>
                        <property name="can_focus">True</property>
                        <property name="tooltip_text" translatable="yes">Arma tu propio plan: elige libros, días y ritmo</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkButton" id="btn_editar">
                        <property name="label" translatable="yes">Editar</property>
                        <property name="visible">True</property>
                        <property name="can_focus">True</property>
                        <property name="tooltip_text" translatable="yes">Cambiar los libros o los días de un plan tuyo</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkButton" id="btn_borrar">
                        <property name="label" translatable="yes">Borrar</property>
                        <property name="visible">True</property>
                        <property name="can_focus">True</property>
                        <property name="tooltip_text" translatable="yes">Borrar un plan tuyo</property>
                      </object>
                    </child>
                  </object>
                  <packing>
                    <property name="expand">False</property>
                  </packing>
                </child>
              </object>
              <packing>
                <property name="resize">False</property>
                <property name="shrink">False</property>
              </packing>
            </child>
            <child>
              <object class="GtkBox" id="box_der">
                <property name="visible">True</property>
                <property name="orientation">vertical</property>
                <property name="spacing">6</property>
                <property name="margin_start">12</property>
                <child>
                  <object class="GtkLabel" id="lbl_nombre">
                    <property name="visible">True</property>
                    <property name="xalign">0</property>
                    <property name="label"></property>
                  </object>
                  <packing>
                    <property name="expand">False</property>
                  </packing>
                </child>
                <child>
                  <object class="GtkLabel" id="lbl_desc">
                    <property name="visible">True</property>
                    <property name="xalign">0</property>
                    <property name="yalign">0</property>
                    <property name="wrap">True</property>
                    <property name="max_width_chars">64</property>
                    <property name="label"></property>
                  </object>
                  <packing>
                    <property name="expand">False</property>
                  </packing>
                </child>
                <child>
                  <object class="GtkProgressBar" id="barra">
                    <property name="visible">True</property>
                    <property name="show_text">True</property>
                    <property name="margin_top">4</property>
                  </object>
                  <packing>
                    <property name="expand">False</property>
                  </packing>
                </child>
                <child>
                  <object class="GtkLabel" id="lbl_estado">
                    <property name="visible">True</property>
                    <property name="xalign">0</property>
                    <property name="label"></property>
                  </object>
                  <packing>
                    <property name="expand">False</property>
                  </packing>
                </child>
                <child>
                  <object class="GtkBox" id="box_botones">
                    <property name="visible">True</property>
                    <property name="spacing">6</property>
                    <property name="margin_top">4</property>
                    <child>
                      <object class="GtkButton" id="btn_empezar">
                        <property name="label" translatable="yes">Empezar este plan</property>
                        <property name="visible">True</property>
                        <property name="can_focus">True</property>
                        <property name="receives_default">True</property>
                      </object>
                      <packing>
                        <property name="expand">False</property>
                      </packing>
                    </child>
                    <child>
                      <object class="GtkButton" id="btn_hoy">
                        <property name="label" translatable="yes">Abrir la lectura de hoy</property>
                        <property name="visible">True</property>
                        <property name="can_focus">True</property>
                      </object>
                      <packing>
                        <property name="expand">False</property>
                      </packing>
                    </child>
                    <child>
                      <object class="GtkButton" id="btn_al_dia">
                        <property name="label" translatable="yes">Ponerme al día</property>
                        <property name="visible">True</property>
                        <property name="can_focus">True</property>
                        <property name="tooltip_text" translatable="yes">Recuperar los días que te has saltado</property>
                      </object>
                      <packing>
                        <property name="expand">False</property>
                      </packing>
                    </child>
                    <child>
                      <object class="GtkButton" id="btn_progreso">
                        <property name="label" translatable="yes">Ver progreso</property>
                        <property name="visible">True</property>
                        <property name="can_focus">True</property>
                        <property name="tooltip_text" translatable="yes">Cuánto llevas leído por plan, por libro y de la Biblia entera</property>
                      </object>
                      <packing>
                        <property name="expand">False</property>
                        <property name="pack_type">end</property>
                      </packing>
                    </child>
                    <child>
                      <object class="GtkButton" id="btn_reiniciar">
                        <property name="label" translatable="yes">Reiniciar</property>
                        <property name="visible">True</property>
                        <property name="can_focus">True</property>
                      </object>
                      <packing>
                        <property name="expand">False</property>
                        <property name="pack_type">end</property>
                      </packing>
                    </child>
                  </object>
                  <packing>
                    <property name="expand">False</property>
                  </packing>
                </child>
                <child>
                  <object class="GtkScrolledWindow" id="scroll_dias">
                    <property name="visible">True</property>
                    <property name="can_focus">True</property>
                    <property name="shadow_type">in</property>
                    <property name="margin_top">4</property>
                    <child>
                      <object class="GtkTreeView" id="tree_dias">
                        <property name="visible">True</property>
                        <property name="can_focus">True</property>
                        <property name="enable_search">False</property>
                        <property name="tooltip_text" translatable="yes">Doble clic en un día para abrir su lectura</property>
                      </object>
                    </child>
                  </object>
                  <packing>
                    <property name="expand">True</property>
                    <property name="fill">True</property>
                  </packing>
                </child>
              </object>
              <packing>
                <property name="resize">True</property>
                <property name="shrink">False</property>
              </packing>
            </child>
          </object>
          <packing>
            <property name="expand">True</property>
            <property name="fill">True</property>
          </packing>
        </child>
        <child>
          <object class="GtkBox" id="box_recordatorio">
            <property name="visible">True</property>
            <property name="spacing">6</property>
            <property name="margin_start">12</property>
            <property name="margin_end">12</property>
            <child>
              <object class="GtkCheckButton" id="chk_recordatorio">
                <property name="label" translatable="yes">Recordármelo cada día a las</property>
                <property name="visible">True</property>
                <property name="can_focus">True</property>
                <property name="tooltip_text" translatable="yes">Un aviso del escritorio, en este equipo, aunque la aplicación esté cerrada</property>
              </object>
              <packing>
                <property name="expand">False</property>
              </packing>
            </child>
            <child>
              <object class="GtkSpinButton" id="spin_hora">
                <property name="visible">True</property>
                <property name="can_focus">True</property>
                <property name="adjustment">adj_hora</property>
                <property name="numeric">True</property>
                <property name="wrap">True</property>
                <property name="width_chars">2</property>
                <property name="max_width_chars">2</property>
              </object>
              <packing>
                <property name="expand">False</property>
              </packing>
            </child>
            <child>
              <object class="GtkLabel" id="lbl_dospuntos">
                <property name="visible">True</property>
                <property name="label">:</property>
              </object>
              <packing>
                <property name="expand">False</property>
              </packing>
            </child>
            <child>
              <object class="GtkSpinButton" id="spin_minuto">
                <property name="visible">True</property>
                <property name="can_focus">True</property>
                <property name="adjustment">adj_minuto</property>
                <property name="numeric">True</property>
                <property name="wrap">True</property>
                <property name="width_chars">2</property>
                <property name="max_width_chars">2</property>
              </object>
              <packing>
                <property name="expand">False</property>
              </packing>
            </child>
            <child>
              <object class="GtkButton" id="btn_probar">
                <property name="label" translatable="yes">Probar</property>
                <property name="visible">True</property>
                <property name="can_focus">True</property>
                <property name="tooltip_text" translatable="yes">Mandar el aviso ahora para ver cómo se ve</property>
              </object>
              <packing>
                <property name="expand">False</property>
              </packing>
            </child>
            <child>
              <object class="GtkLabel" id="lbl_recordatorio">
                <property name="visible">True</property>
                <property name="xalign">0</property>
                <property name="label"></property>
              </object>
              <packing>
                <property name="expand">True</property>
                <property name="fill">True</property>
              </packing>
            </child>
          </object>
          <packing>
            <property name="expand">False</property>
          </packing>
        </child>
      </object>
    </child>
  </object>
</interface>
