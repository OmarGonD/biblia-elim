<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <object class="GtkWindow" id="window">
    <property name="default-width">1180</property>
    <property name="default-height">760</property>
    <child>
      <object class="GtkBox" id="vbox1">
        <property name="orientation">vertical</property>
        <child>
          <object class="GtkBox" id="box_navbar">
            <property name="orientation">vertical</property>
          </object>
        </child>
        <child>
          <object class="GtkBox" id="ribbon">
            <property name="orientation">vertical</property>
            <style><class name="studypad-ribbon"/></style>
            <child>
              <object class="GtkFlowBox" id="command_flow">
                <property name="selection-mode">none</property>
                <property name="homogeneous">False</property>
                <property name="min-children-per-line">1</property>
                <property name="max-children-per-line">2</property>
                <property name="row-spacing">2</property>
                <property name="column-spacing">0</property>
                <property name="halign">start</property>
                <style><class name="studypad-command-flow"/></style>
                <child>
                  <object class="GtkFlowBoxChild">
                    <child>
                      <object class="GtkBox" id="toolbar1">
                <property name="spacing">5</property>
                <property name="margin-start">8</property><property name="margin-end">8</property>
                <property name="margin-top">2</property><property name="margin-bottom">2</property>
                <child><object class="GtkBox"><property name="orientation">vertical</property><style><class name="ribbon-group"/></style>
                  <child><object class="GtkBox"><property name="spacing">3</property>
                    <child><object class="GtkButton" id="toolbutton_new"><property name="label">Nuevo</property><property name="icon-name">document-new-symbolic</property><property name="tooltip-text">Crear estudio</property></object></child>
                    <child><object class="GtkButton" id="toolbutton_open"><property name="label">Abrir</property><property name="icon-name">document-open-symbolic</property><property name="tooltip-text">Abrir estudio o Word (.docx)</property></object></child>
                    <child><object class="GtkButton" id="toolbutton_import_word"><property name="label">Word</property><property name="icon-name">x-office-document-symbolic</property><property name="tooltip-text">Importar un documento Word (.docx) como estudio editable</property></object></child>
                    <child><object class="GtkButton" id="toolbutton_save"><property name="icon-name">media-floppy-symbolic</property><property name="tooltip-text">Guardar el estudio (Ctrl+S)</property><style><class name="studypad-save-primary"/></style></object></child>
                  </object></child><child><object class="GtkLabel"><property name="label">Archivo</property><style><class name="ribbon-group-title"/></style></object></child>
                </object></child>
                <child><object class="GtkBox"><property name="orientation">vertical</property><style><class name="ribbon-group"/></style>
                  <child><object class="GtkBox"><property name="spacing">3</property>
                    <child><object class="GtkButton" id="toolbutton_cut"><property name="label">Cortar</property><property name="icon-name">edit-cut-symbolic</property></object></child>
                    <child><object class="GtkButton" id="toolbutton_copy"><property name="label">Copiar</property><property name="icon-name">edit-copy-symbolic</property></object></child>
                    <child><object class="GtkButton" id="toolbutton_paste"><property name="label">Pegar</property><property name="icon-name">edit-paste-symbolic</property></object></child>
                    <child><object class="GtkButton" id="toolbutton_find"><property name="label">Buscar</property><property name="icon-name">edit-find-symbolic</property></object></child>
                    <child><object class="GtkButton" id="toolbutton_replace"><property name="label">Reemplazar</property><property name="icon-name">edit-find-replace-symbolic</property></object></child>
                  </object></child><child><object class="GtkLabel"><property name="label">Portapapeles y edición</property><style><class name="ribbon-group-title"/></style></object></child>
                </object></child>
                <child><object class="GtkBox"><property name="orientation">vertical</property><style><class name="ribbon-group"/></style>
                  <child><object class="GtkBox"><property name="spacing">3</property>
                    <child><object class="GtkButton" id="toolbutton_image"><property name="label">Imagen</property><property name="icon-name">insert-image-symbolic</property></object></child>
                    <child><object class="GtkButton" id="toolbutton_sword_link"><property name="label">Versículo</property><property name="icon-name">insert-link-symbolic</property><property name="tooltip-text">Insertar enlace bíblico</property></object></child>
                    <child><object class="GtkButton" id="toolbutton_insert_citation"><property name="label">Cita actual</property><property name="icon-name">bookmark-new-symbolic</property><property name="tooltip-text">Insertar una referencia vinculada al pasaje actual</property></object></child>
                  </object></child><child><object class="GtkLabel"><property name="label">Insertar</property><style><class name="ribbon-group-title"/></style></object></child>
                </object></child>
                <child><object class="GtkBox"><property name="orientation">vertical</property><style><class name="ribbon-group"/></style>
                  <child><object class="GtkBox"><property name="spacing">3</property>
                    <child><object class="GtkButton" id="toolbutton_library"><property name="label">Biblioteca</property><property name="icon-name">folder-symbolic</property></object></child>
                    <child><object class="GtkButton" id="toolbutton_organize"><property name="label">Organizar</property><property name="icon-name">tag-symbolic</property></object></child>
                    <child><object class="GtkButton" id="toolbutton_template"><property name="label">Plantilla</property><property name="icon-name">document-properties-symbolic</property><property name="tooltip-text">Crear un estudio desde una plantilla</property></object></child>
                    <child><object class="GtkButton" id="toolbutton_history"><property name="label">Historial</property><property name="icon-name">document-open-recent-symbolic</property><property name="tooltip-text">Ver y restaurar versiones anteriores</property></object></child>
                  </object></child><child><object class="GtkLabel"><property name="label">Estudios</property><style><class name="ribbon-group-title"/></style></object></child>
                </object></child>
                <child><object class="GtkBox"><property name="orientation">vertical</property><style><class name="ribbon-group"/></style>
                  <child><object class="GtkBox"><property name="spacing">3</property>
                    <child><object class="GtkButton" id="toolbutton_export_docx"><property name="label">Word</property><property name="icon-name">x-office-document-symbolic</property><property name="tooltip-text">Exportar el estudio como documento Word</property></object></child>
                    <child><object class="GtkButton" id="toolbutton_export_pdf"><property name="label">PDF</property><property name="icon-name">application-pdf-symbolic</property><property name="tooltip-text">Exportar el estudio como PDF</property></object></child>
                  </object></child><child><object class="GtkLabel"><property name="label">Exportar</property><style><class name="ribbon-group-title"/></style></object></child>
                </object></child>
                      </object>
                    </child>
                  </object>
                </child>
                <child>
                  <object class="GtkFlowBoxChild">
                    <child>
                      <object class="GtkBox" id="toolbar2">
                <property name="spacing">5</property>
                <property name="margin-start">8</property><property name="margin-end">8</property><property name="margin-bottom">3</property>
                <child><object class="GtkBox"><property name="orientation">vertical</property><style><class name="ribbon-group"/></style>
                  <child><object class="GtkBox"><property name="spacing">3</property>
                    <child><object class="GtkToggleButton" id="toolbutton_bold"><property name="icon-name">format-text-bold-symbolic</property><property name="tooltip-text">Negrita</property><style><class name="ribbon-format-button"/></style></object></child>
                    <child><object class="GtkToggleButton" id="toolbutton_italic"><property name="icon-name">format-text-italic-symbolic</property><property name="tooltip-text">Cursiva</property><style><class name="ribbon-format-button"/></style></object></child>
                    <child><object class="GtkToggleButton" id="toolbuttonunderline"><property name="tooltip-text">Subrayado</property><property name="child"><object class="GtkLabel"><property name="label">&lt;u&gt;U&lt;/u&gt;</property><property name="use-markup">True</property></object></property><style><class name="ribbon-format-button"/><class name="ribbon-underline-button"/></style></object></child>
                    <child><object class="GtkToggleButton" id="toolbutton_strikethrough"><property name="icon-name">format-text-strikethrough-symbolic</property><property name="tooltip-text">Tachado</property></object></child>
                    <child><object class="GtkDropDown" id="comboboxtext1"><property name="model"><object class="GtkStringList"><items>
                      <item>Normal</item><item>Encabezado 1</item><item>Encabezado 2</item><item>Encabezado 3</item><item>Encabezado 4</item><item>Encabezado 5</item><item>Encabezado 6</item><item>Dirección</item><item>Preformateado</item><item>Lista con viñetas</item><item>Lista romana</item><item>Lista numerada</item><item>Lista alfabética</item>
                    </items></object></property></object></child>
                    <child><object class="GtkOverlay" id="text_color_picker_overlay"><property name="width-request">38</property><property name="height-request">28</property><child><object class="GtkColorDialogButton" id="colorbutton1"><property name="width-request">38</property><property name="height-request">28</property><property name="tooltip-text">Color del texto</property></object></child><child type="overlay"><object class="GtkLabel"><property name="label">A</property><property name="can-target">False</property><style><class name="ribbon-text-color-glyph"/></style></object></child></object></child>
                    <child><object class="GtkColorDialogButton" id="colorbutton_highlight"><property name="width-request">38</property><property name="height-request">24</property><property name="tooltip-text">Resaltado</property></object></child>
                  </object></child><child><object class="GtkLabel"><property name="label">Fuente y estilo</property><style><class name="ribbon-group-title"/></style></object></child>
                </object></child>
                <child><object class="GtkBox"><property name="orientation">vertical</property><style><class name="ribbon-group"/></style>
                  <child><object class="GtkBox"><property name="spacing">3</property>
                    <child><object class="GtkButton" id="toolbutton_align_left"><property name="icon-name">format-justify-left-symbolic</property><property name="tooltip-text">Alinear a la izquierda</property></object></child>
                    <child><object class="GtkButton" id="toolbutton_align_center"><property name="icon-name">format-justify-center-symbolic</property><property name="tooltip-text">Centrar</property></object></child>
                    <child><object class="GtkButton" id="toolbutton_align_right"><property name="icon-name">format-justify-right-symbolic</property><property name="tooltip-text">Alinear a la derecha</property></object></child>
                    <child><object class="GtkButton" id="toolbutton_align_justify"><property name="icon-name">format-justify-fill-symbolic</property><property name="tooltip-text">Justificar</property></object></child>
                  </object></child><child><object class="GtkLabel"><property name="label">Párrafo</property><style><class name="ribbon-group-title"/></style></object></child>
                </object></child>
                <child><object class="GtkBox" id="study_zoom_group"><property name="orientation">vertical</property><style><class name="ribbon-group"/></style>
                  <child><object class="GtkBox"><property name="spacing">3</property>
                    <child><object class="GtkButton" id="study_zoom_out"><property name="icon-name">zoom-out-symbolic</property><property name="tooltip-text">Reducir zoom del estudio (Ctrl+-)</property></object></child>
                    <child><object class="GtkButton" id="study_zoom_reset"><property name="label">100 %</property><property name="tooltip-text">Restablecer zoom del estudio (Ctrl+0)</property></object></child>
                    <child><object class="GtkButton" id="study_zoom_in"><property name="icon-name">zoom-in-symbolic</property><property name="tooltip-text">Ampliar zoom del estudio (Ctrl++)</property></object></child>
                  </object></child><child><object class="GtkLabel"><property name="label">Zoom del estudio</property><style><class name="ribbon-group-title"/></style></object></child>
                </object></child>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="GtkScrolledWindow" id="scrolledwindow1">
            <property name="vexpand">True</property>
            <property name="hexpand">True</property>
          </object>
        </child>
      </object>
    </child>
  </object>
  <object class="GtkDialog" id="dialog_find_replace">
    <child>
      <object class="GtkBox" id="box4">
        <property name="orientation">vertical</property>
        <child><object class="GtkEntry" id="entry1"/></child>
        <child><object class="GtkEntry" id="entry2"/></child>
        <child><object class="GtkButton" id="button_replace"><property name="label">Reemplazar</property></object></child>
      </object>
    </child>
  </object>
</interface>
