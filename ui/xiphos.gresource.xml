  Lists the .gtkbuilder / .ui files compiled directly into the xiphos
  binary via glib-compile-resources, instead of being looked up on
  disk at runtime through gui_general_user_file(). Each file is
  reachable at runtime as "/org/xiphos/ui/<filename>".
-->
<gresources>
  <gresource prefix="/org/xiphos/ui">
    <file>bookmarks.gtkbuilder</file>
    <file>editor_link_dialog.gtkbuilder</file>
    <file>export-dialog.gtkbuilder</file>
    <file>folder.gtkbuilder</file>
    <file>gtk_webedit.ui</file>
    <file>markverse.gtkbuilder</file>
    <file>module-manager.gtkbuilder</file>
    <file>navbar_versekey.gtkbuilder</file>
    <file>nube-palabras.gtkbuilder</file>
    <file>planes-lectura.gtkbuilder</file>
    <file>plan-personal.gtkbuilder</file>
    <file>progreso-lectura.gtkbuilder</file>
    <file>prefs.gtkbuilder</file>
    <file>search-dialog.gtkbuilder</file>
    <file>selector-prefs.gtkbuilder</file>
    <file>xi-export-bookmarks.gtkbuilder</file>
    <file>xi-menus-popup.gtkbuilder</file>
    <file>xi-menus.gtkbuilder</file>
    <file>xi-splash.gtkbuilder</file>
    <file>xiphos-style.css</file>
    <file>languages</file>
    <file>diccionario-elim.xml</file>
    <file>diccionario.gtkbuilder</file>
    <file>strongs-elim.xml</file>

    <!--
      Images referenced by relative <property name="pixbuf">file.png</property>
      inside the .gtkbuilder files above. GtkBuilder resolves those paths
      relative to this same resource prefix when the .gtkbuilder itself is
      loaded via gtk_builder_add_from_resource() - so each image must be
      bundled here too, or the icon silently fails to load (found the hard
      way: prefs/module-manager/splash icons went blank after switching to
      GResource, see issue #894 item 4 follow-up).
    -->
    <file>logo.png</file>
    <file>biblesync-v1-50.png</file>
    <file>sword3.png</file>
    <file>splash.png</file>
    <file>gnome-windows.png</file>
    <file>sword.png</file>
    <file>gnome-session.png</file>
    <file>gs2-48x48.png</file>
    <file>xiphos-x-16.png</file>
  </gresource>
</gresources>
