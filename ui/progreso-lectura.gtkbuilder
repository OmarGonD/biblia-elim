<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.0"/>
  <object class="GtkDialog" id="dialog_progreso">
    <property name="can_focus">False</property>
    <property name="title" translatable="yes">Tu progreso</property>
    <property name="default_width">720</property>
    <property name="default_height">640</property>
    <child>
      <object class="GtkBox" id="dialog-vbox">
        <property name="visible">True</property>
        <property name="orientation">vertical</property>
        <property name="spacing">8</property>
        <child>
          <object class="GtkBox" id="box_todo">
            <property name="visible">True</property>
            <property name="orientation">vertical</property>
            <property name="spacing">6</property>
            <property name="margin_start">12</property>
            <property name="margin_end">12</property>
            <property name="margin_top">8</property>
            <child>
              <object class="GtkLabel" id="lbl_total">
                <property name="visible">True</property>
                <property name="xalign">0</property>
                <property name="label"></property>
              </object>
            </child>
            <child>
              <object class="GtkProgressBar" id="barra_total">
                <property name="visible">True</property>
                <property name="show_text">False</property>
              </object>
            </child>
            <child>
              <object class="GtkLabel" id="lbl_testamentos">
                <property name="visible">True</property>
                <property name="xalign">0</property>
                <property name="margin_bottom">6</property>
                <property name="label"></property>
              </object>
            </child>
            <child>
              <object class="GtkNotebook" id="cuadernillo">
                <property name="visible">True</property>
                <property name="can_focus">True</property>
                <child>
                  <object class="GtkScrolledWindow" id="scroll_libros">
                    <property name="visible">True</property>
                    <property name="can_focus">True</property>
                    <property name="hscrollbar_policy">never</property>
                    <child>
                      <object class="GtkListView" id="tree_libros">
                        <property name="visible">True</property>
                        <property name="can_focus">True</property>
                      </object>
                    </child>
                  </object>
                </child>
                <child type="tab">
                  <object class="GtkLabel" id="tab_libros">
                    <property name="visible">True</property>
                    <property name="label" translatable="yes">Por libro</property>
                  </object>
                </child>
                <child>
                  <object class="GtkScrolledWindow" id="scroll_planes">
                    <property name="visible">True</property>
                    <property name="can_focus">True</property>
                    <property name="hscrollbar_policy">never</property>
                    <child>
                      <object class="GtkListView" id="tree_planes">
                        <property name="visible">True</property>
                        <property name="can_focus">True</property>
                      </object>
                    </child>
                  </object>
                </child>
                <child type="tab">
                  <object class="GtkLabel" id="tab_planes">
                    <property name="visible">True</property>
                    <property name="label" translatable="yes">Por plan</property>
                  </object>
                </child>
                <child>
                  <object class="GtkBox" id="box_constancia">
                    <property name="visible">True</property>
                    <property name="orientation">vertical</property>
                    <property name="spacing">10</property>
                    <property name="margin_start">12</property>
                    <property name="margin_end">12</property>
                    <property name="margin_top">14</property>
                    <property name="margin_bottom">10</property>
                    <child>
                      <object class="GtkLabel" id="lbl_racha">
                        <property name="visible">True</property>
                        <property name="xalign">0</property>
                        <property name="label"></property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel" id="lbl_racha_pie">
                        <property name="visible">True</property>
                        <property name="xalign">0</property>
                        <property name="wrap">True</property>
                        <property name="label"></property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkScrolledWindow" id="scroll_calendario">
                        <property name="visible">True</property>
                        <property name="can_focus">True</property>
                        <property name="vscrollbar_policy">never</property>
                        <child>
                          <object class="GtkDrawingArea" id="calendario">
                            <property name="visible">True</property>
                            <property name="has_tooltip">True</property>
                          </object>
                        </child>
                      <property name="vexpand">True</property>
                      <property name="valign">center</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel" id="lbl_calendario_pie">
                        <property name="visible">True</property>
                        <property name="xalign">0</property>
                        <property name="wrap">True</property>
                        <property name="label"></property>
                      </object>
                    </child>
                  </object>
                </child>
                <child type="tab">
                  <object class="GtkLabel" id="tab_constancia">
                    <property name="visible">True</property>
                    <property name="label" translatable="yes">Constancia</property>
                  </object>
                </child>
              <property name="vexpand">True</property>
              </object>
            </child>
            <child>
              <object class="GtkLabel" id="lbl_nota">
                <property name="visible">True</property>
                <property name="xalign">0</property>
                <property name="wrap">True</property>
                <property name="label"></property>
              </object>
            </child>
          <property name="vexpand">True</property>
          </object>
        </child>
        <child>
          <object class="GtkBox" id="action_area">
            <property name="halign">end</property>
            <property name="margin_start">12</property>
            <property name="margin_end">12</property>
            <property name="margin_top">4</property>
            <property name="margin_bottom">12</property>
            <property name="visible">True</property>
            <child>
              <object class="GtkButton" id="btn_cerrar">
                <property name="label" translatable="yes">Cerrar</property>
                <property name="visible">True</property>
                <property name="can_focus">True</property>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
  </object>
</interface>
