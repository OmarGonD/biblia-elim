<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.0"/>
  <object class="GtkDialog" id="dialog_testimonios">
    <property name="can_focus">False</property>
    <property name="title" translatable="yes">Jesús en la historia</property>
    <property name="default_width">960</property>
    <property name="default_height">660</property>
    <child>
      <object class="GtkBox" id="dialog-vbox">
        <property name="visible">True</property>
        <property name="orientation">vertical</property>
        <property name="spacing">8</property>
        <child>
          <object class="GtkBox" id="box_contenido">
            <property name="visible">True</property>
            <property name="orientation">vertical</property>
            <property name="spacing">6</property>
            <property name="margin_start">12</property>
            <property name="margin_end">12</property>
            <property name="margin_top">8</property>
            <child>
              <object class="GtkLabel" id="lbl_cabecera">
                <property name="visible">True</property>
                <property name="xalign">0</property>
                <property name="wrap">True</property>
                <property name="label" translatable="yes">Lo que dicen de Jesús las fuentes que no son la Biblia.</property>
              </object>
            </child>
            <child>
              <object class="GtkPaned" id="paned">
                  <property name="resize-end-child">True</property>
                  <property name="shrink-end-child">True</property>
                  <property name="resize-start-child">False</property>
                  <property name="shrink-start-child">False</property>
                <property name="visible">True</property>
                <property name="orientation">horizontal</property>
                <property name="position">340</property>
                <child>
                  <object class="GtkScrolledWindow" id="scroll_fuentes">
                    <property name="visible">True</property>
                    <property name="min_content_width">300</property>
                    <property name="hscrollbar_policy">automatic</property>
                    <child>
                      <object class="GtkListView" id="tree_fuentes">
                        <property name="visible">True</property>
                        <property name="can_focus">True</property>
                      </object>
                    </child>
                  </object>
                </child>
                <child>
                  <object class="GtkBox" id="box_html">
                    <property name="visible">True</property>
                    <property name="orientation">vertical</property>
                  </object>
                </child>
              <property name="vexpand">True</property>
              </object>
            </child>
            <child>
              <object class="GtkLabel" id="lbl_pie">
                <property name="visible">True</property>
                <property name="xalign">0</property>
                <property name="wrap">True</property>
                <property name="label"></property>
              </object>
            </child>
          <property name="vexpand">True</property>
          </object>
        </child>
        <child>
          <object class="GtkBox" id="action_area">
            <property name="halign">end</property>
            <property name="margin_start">12</property>
            <property name="margin_end">12</property>
            <property name="margin_top">4</property>
            <property name="margin_bottom">12</property>
            <property name="visible">True</property>
            <child>
              <object class="GtkButton" id="btn_cerrar">
                <property name="label" translatable="yes">Cerrar</property>
                <property name="visible">True</property>
                <property name="can_focus">True</property>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
  </object>
</interface>
