<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk+" version="3.14"/>
  <object class="GtkAdjustment" id="adj_dias">
    <property name="lower">1</property>
    <property name="upper">3650</property>
    <property name="value">30</property>
    <property name="step_increment">1</property>
    <property name="page_increment">7</property>
  </object>
  <object class="GtkAdjustment" id="adj_ritmo">
    <property name="lower">1</property>
    <property name="upper">100</property>
    <property name="value">3</property>
    <property name="step_increment">1</property>
    <property name="page_increment">5</property>
  </object>
  <object class="GtkDialog" id="dialog_personal">
    <property name="can_focus">False</property>
    <property name="title" translatable="yes">Plan personalizado</property>
    <property name="icon">xiphos-x-16.png</property>
    <property name="default_width">820</property>
    <property name="default_height">620</property>
    <property name="type_hint">dialog</property>
    <child internal-child="vbox">
      <object class="GtkBox" id="dialog-vbox">
        <property name="visible">True</property>
        <property name="orientation">vertical</property>
        <property name="spacing">8</property>
        <child internal-child="action_area">
          <object class="GtkButtonBox" id="action_area">
            <property name="visible">True</property>
            <property name="layout_style">end</property>
            <child>
              <object class="GtkButton" id="btn_cancelar">
                <property name="label" translatable="yes">Cancelar</property>
                <property name="visible">True</property>
                <property name="can_focus">True</property>
              </object>
            </child>
            <child>
              <object class="GtkButton" id="btn_guardar">
                <property name="label" translatable="yes">Guardar el plan</property>
                <property name="visible">True</property>
                <property name="can_focus">True</property>
                <property name="can_default">True</property>
                <property name="receives_default">True</property>
              </object>
            </child>
          </object>
          <packing>
            <property name="expand">False</property>
            <property name="pack_type">end</property>
            <property name="position">2</property>
          </packing>
        </child>
        <child>
          <object class="GtkBox" id="box_todo">
            <property name="visible">True</property>
            <property name="spacing">12</property>
            <property name="margin_start">12</property>
            <property name="margin_end">12</property>
            <property name="margin_top">8</property>
            <child>
              <object class="GtkBox" id="box_libros">
                <property name="visible">True</property>
                <property name="orientation">vertical</property>
                <property name="spacing">6</property>
                <child>
                  <object class="GtkLabel" id="lbl_libros">
                    <property name="visible">True</property>
                    <property name="xalign">0</property>
                    <property name="label" translatable="yes">Qué libros quieres leer</property>
                  </object>
                  <packing>
                    <property name="expand">False</property>
                  </packing>
                </child>
                <child>
                  <object class="GtkScrolledWindow" id="scroll_libros">
                    <property name="visible">True</property>
                    <property name="can_focus">True</property>
                    <property name="shadow_type">in</property>
                    <property name="hscrollbar_policy">never</property>
                    <child>
                      <object class="GtkTreeView" id="tree_libros">
                        <property name="visible">True</property>
                        <property name="can_focus">True</property>
                        <property name="headers_visible">False</property>
                        <property name="enable_search">True</property>
                      </object>
                    </child>
                  </object>
                  <packing>
                    <property name="expand">True</property>
                    <property name="fill">True</property>
                  </packing>
                </child>
                <child>
                  <object class="GtkBox" id="box_atajos">
                    <property name="visible">True</property>
                    <property name="spacing">4</property>
                    <property name="homogeneous">True</property>
                    <child>
                      <object class="GtkButton" id="btn_todo">
                        <property name="label" translatable="yes">Toda la Biblia</property>
                        <property name="visible">True</property>
                        <property name="can_focus">True</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkButton" id="btn_at">
                        <property name="label" translatable="yes">Antiguo</property>
                        <property name="visible">True</property>
                        <property name="can_focus">True</property>
                        <property name="tooltip_text" translatable="yes">Todo el Antiguo Testamento</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkButton" id="btn_nt">
                        <property name="label" translatable="yes">Nuevo</property>
                        <property name="visible">True</property>
                        <property name="can_focus">True</property>
                        <property name="tooltip_text" translatable="yes">Todo el Nuevo Testamento</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkButton" id="btn_evangelios">
                        <property name="label" translatable="yes">Evangelios</property>
                        <property name="visible">True</property>
                        <property name="can_focus">True</property>
                        <property name="tooltip_text" translatable="yes">Mateo, Marcos, Lucas y Juan</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkButton" id="btn_nada">
                        <property name="label" translatable="yes">Ninguno</property>
                        <property name="visible">True</property>
                        <property name="can_focus">True</property>
                      </object>
                    </child>
                  </object>
                  <packing>
                    <property name="expand">False</property>
                  </packing>
                </child>
              </object>
              <packing>
                <property name="expand">True</property>
                <property name="fill">True</property>
              </packing>
            </child>
            <child>
              <object class="GtkBox" id="box_ajustes">
                <property name="visible">True</property>
                <property name="orientation">vertical</property>
                <property name="spacing">6</property>
                <property name="width_request">300</property>
                <child>
                  <object class="GtkLabel" id="lbl_nombre">
                    <property name="visible">True</property>
                    <property name="xalign">0</property>
                    <property name="label" translatable="yes">Nombre del plan</property>
                  </object>
                  <packing>
                    <property name="expand">False</property>
                  </packing>
                </child>
                <child>
                  <object class="GtkEntry" id="ent_nombre">
                    <property name="visible">True</property>
                    <property name="can_focus">True</property>
                    <property name="activates_default">True</property>
                    <property name="max_length">80</property>
                  </object>
                  <packing>
                    <property name="expand">False</property>
                  </packing>
                </child>
                <child>
                  <object class="GtkLabel" id="lbl_ritmo_tit">
                    <property name="visible">True</property>
                    <property name="xalign">0</property>
                    <property name="margin_top">10</property>
                    <property name="label" translatable="yes">Cuánto quieres que dure</property>
                  </object>
                  <packing>
                    <property name="expand">False</property>
                  </packing>
                </child>
                <child>
                  <object class="GtkGrid" id="grid_ritmo">
                    <property name="visible">True</property>
                    <property name="row_spacing">6</property>
                    <property name="column_spacing">8</property>
                    <child>
                      <object class="GtkLabel" id="lbl_dias">
                        <property name="visible">True</property>
                        <property name="xalign">0</property>
                        <property name="label" translatable="yes">Días</property>
                      </object>
                      <packing>
                        <property name="left_attach">0</property>
                        <property name="top_attach">0</property>
                      </packing>
                    </child>
                    <child>
                      <object class="GtkSpinButton" id="spin_dias">
                        <property name="visible">True</property>
                        <property name="can_focus">True</property>
                        <property name="adjustment">adj_dias</property>
                        <property name="numeric">True</property>
                        <property name="hexpand">True</property>
                      </object>
                      <packing>
                        <property name="left_attach">1</property>
                        <property name="top_attach">0</property>
                      </packing>
                    </child>
                    <child>
                      <object class="GtkLabel" id="lbl_capdia">
                        <property name="visible">True</property>
                        <property name="xalign">0</property>
                        <property name="label" translatable="yes">Capítulos por día</property>
                      </object>
                      <packing>
                        <property name="left_attach">0</property>
                        <property name="top_attach">1</property>
                      </packing>
                    </child>
                    <child>
                      <object class="GtkSpinButton" id="spin_ritmo">
                        <property name="visible">True</property>
                        <property name="can_focus">True</property>
                        <property name="adjustment">adj_ritmo</property>
                        <property name="numeric">True</property>
                        <property name="hexpand">True</property>
                        <property name="tooltip_text" translatable="yes">Como mucho, capítulos que leerás cada día</property>
                      </object>
                      <packing>
                        <property name="left_attach">1</property>
                        <property name="top_attach">1</property>
                      </packing>
                    </child>
                  </object>
                  <packing>
                    <property name="expand">False</property>
                  </packing>
                </child>
                <child>
                  <object class="GtkLabel" id="lbl_resumen">
                    <property name="visible">True</property>
                    <property name="xalign">0</property>
                    <property name="yalign">0</property>
                    <property name="wrap">True</property>
                    <property name="max_width_chars">36</property>
                    <property name="margin_top">10</property>
                    <property name="label"></property>
                  </object>
                  <packing>
                    <property name="expand">True</property>
                    <property name="fill">True</property>
                  </packing>
                </child>
                <child>
                  <object class="GtkLabel" id="lbl_aviso">
                    <property name="xalign">0</property>
                    <property name="yalign">1</property>
                    <property name="wrap">True</property>
                    <property name="max_width_chars">36</property>
                    <property name="label"></property>
                  </object>
                  <packing>
                    <property name="expand">False</property>
                  </packing>
                </child>
              </object>
              <packing>
                <property name="expand">False</property>
                <property name="fill">True</property>
              </packing>
            </child>
          </object>
          <packing>
            <property name="expand">True</property>
            <property name="fill">True</property>
          </packing>
        </child>
      </object>
    </child>
    <action-widgets>
      <action-widget response="-6">btn_cancelar</action-widget>
      <action-widget response="-5">btn_guardar</action-widget>
    </action-widgets>
  </object>
</interface>
